{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "MindTree 桌面主窗口所需的最小权限",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*" },
        { "url": "https://*:*" },
        { "url": "http://106.54.44.45:18789/*" }
      ]
    }
  ]
}
