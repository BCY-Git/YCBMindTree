{
  "name": "@mindtree/agent-graph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./workspace-agent": {
      "types": "./dist/workspace-agent.d.mts",
      "import": "./dist/workspace-agent.mjs",
      "default": "./dist/workspace-agent.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/workspace-agent.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "deepagents": "^1.13.2",
    "langchain": "^1.5.10"
  },
  "peerDependenciesMeta": {
    "deepagents": { "optional": true },
    "langchain": { "optional": true }
  },
  "devDependencies": {
    "deepagents": "1.13.2",
    "langchain": "1.5.10",
    "@types/node": "^24.0.0",
    "tsdown": "0.22.14",
    "typescript": "5.9.3",
    "vitest": "^4.1.9"
  }
}
